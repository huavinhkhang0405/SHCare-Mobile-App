  },
  "quotes": [
    {
      "id": "exercise_task_completed_001",
      "text": "Có công mài sắt, có ngày nên kim. Hôm nay bạn đã mài thêm một nét cho sức khỏe của mình!",
      "source_type": "tuc_ngu",
      "source_name": "Tục ngữ Việt Nam",
      "author": null,
      "verified": true,
      "confidence": "high",
      "category_id": "exercise",
      "event_type": "task_completed",
      "tone": "celebratory"
    },
    {
      "id": "exercise_task_completed_002",
      "text": "Chân cứng đá mềm — bạn vừa chứng minh điều đó bằng chính đôi chân mình!",
      "source_type": "tuc_ngu",
      "source_name": "Tục ngữ Việt Nam",
      "author": null,
      "verified": true,
      "confidence": "high",
      "category_id": "exercise",
      "event_type": "task_completed",
      "tone": "celebratory"
    },
    {
      "id": "exercise_task_completed_003",
      "text": "Dẻo dai vì luyện tập, cứng cáp vì bền chí. Hôm nay bạn làm được cả hai!",
      "source_type": "sang_tac",
      "source_name": "Sáng tác - Triết lý Việt",
      "author": null,
      "verified": true,
      "confidence": "medium",
      "category_id": "exercise",
      "event_type": "task_completed",
      "tone": "celebratory"
    },
    {
      "id": "exercise_task_completed_004",
      "text": "Cơ thể khỏe mạnh là người bạn trung thành nhất — và hôm nay bạn đã chăm sóc người bạn đó rồi!",
      "source_type": "sang_tac",
      "source_name": "Sáng tác - Triết lý Việt",
      "author": null,
      "verified": true,
      "confidence": "medium",
      "category_id": "exercise",
      "event_type": "task_completed",
      "tone": "inspirational"
    },
    {
      "id": "exercise_task_completed_005",
      "text": "Một ngày tập luyện không làm bạn mạnh ngay, nhưng một ngày bỏ tập làm bạn yếu dần. Hôm nay bạn đã chọn đúng!",
      "source_type": "sang_tac",
      "source_name": "Sáng tác - Triết lý Việt",
      "author": null,
      "verified": true,
      "confidence": "medium",
      "category_id": "exercise",
      "event_type": "task_completed",
      "tone": "strong"
    },
    {
      "id": "exercise_task_completed_006",
      "text": "Thân thể là ngôi đền linh thiêng nhất — bạn vừa dâng lên đó một buổi lễ!",
      "source_type": "sang_tac",
      "source_name": "Sáng tác - Triết lý Việt",
      "author": null,
      "verified": true,
      "confidence": "medium",
      "category_id": "exercise",
      "event_type": "task_completed",
      "tone": "inspirational"
    },
    {
      "id": "exercise_reminder_001",
      "text": "Đi một ngày đàng, học một sàng khôn — và một ngày vận động, khỏe thêm một bậc!",
      "source_type": "tuc_ngu",
      "source_name": "Tục ngữ Việt Nam",
      "author": null,
      "verified": true,
      "confidence": "high",
      "category_id": "exercise",
      "event_type": "reminder",
      "tone": "gentle"
    },
    {
      "id": "exercise_reminder_002",
      "text": "Hành trình ngàn dặm bắt đầu từ một bước chân. Bước chân hôm nay của bạn đang ở đâu?",
      "source_type": "sang_tac",
      "source_name": "Sáng tác - Triết lý Việt",
      "author": null,
      "verified": true,
      "confidence": "medium",
      "category_id": "exercise",
      "event_type": "reminder",
      "tone": "gentle"
    },
    {
      "id": "exercise_reminder_003",
      "text": "Cơ thể bạn đang nhắn tin: 'Mình cần được vận động hôm nay!' Đừng để nó chờ lâu nha!",
      "source_type": "sang_tac",
      "source_name": "Sáng tác - Triết lý Việt",
      "author": null,
      "verified": true,
      "confidence": "medium",
      "category_id": "exercise",
      "event_type": "reminder",
      "tone": "gentle"
    },
    {
      "id": "exercise_reminder_004",
      "text": "Người lười biếng nói 'ngày mai', người thành công nói 'bây giờ'. Bạn chọn bên nào?",
      "source_type": "sang_tac",
      "source_name": "Sáng tác - Triết lý Việt",
      "author": null,
      "verified": true,
      "confidence": "medium",
      "category_id": "exercise",
      "event_type": "reminder",
      "tone": "strong"
    },
    {
      "id": "exercise_reminder_005",
      "text": "Mưa dầm thấm đất — chỉ cần 15 phút vận động thôi, cũng đủ để cơ thể cảm ơn bạn!",
      "source_type": "tuc_ngu",
      "source_name": "Tục ngữ Việt Nam",
      "author": null,
      "verified": true,
      "confidence": "high",
      "category_id": "exercise",
      "event_type": "reminder",
      "tone": "gentle"
    },
    {
      "id": "exercise_reminder_006",
      "text": "Thương thân mình lấy — hãy cho cơ thể bạn cơ hội được vận động hôm nay!",
      "source_type": "sang_tac",
      "source_name": "Sáng tác - Triết lý Việt",
      "author": null,
      "verified": true,
      "confidence": "medium",
      "category_id": "exercise",
      "event_type": "reminder",
      "tone": "gentle"
    },
    {
      "id": "exercise_streak_001",
      "text": "Kiên trì là mẹ của thành công — bạn đang chứng minh điều đó bằng chính chuỗi ngày bền bỉ của mình!",
      "source_type": "tuc_ngu",
      "source_name": "Tục ngữ Việt Nam",
      "author": null,
      "verified": true,
      "confidence": "high",
      "category_id": "exercise",
      "event_type": "streak_milestone",
      "tone": "celebratory"
    },
    {
      "id": "exercise_streak_002",
      "text": "Lửa thử vàng, gian nan thử sức. Bạn đã vượt qua thử thách và sức khỏe đang rực sáng!",
      "source_type": "tuc_ngu",
      "source_name": "Tục ngữ Việt Nam",
      "author": null,
      "verified": true,
      "confidence": "high",
      "category_id": "exercise",
      "event_type": "streak_milestone",
      "tone": "strong"
    },
    {
      "id": "exercise_streak_003",
      "text": "Tre già măng mọc — mỗi ngày bạn tập luyện là một mầm sức khỏe mới đang vươn lên!",
      "source_type": "tuc_ngu",
      "source_name": "Tục ngữ Việt Nam",
      "author": null,
      "verified": true,
      "confidence": "high",
      "category_id": "exercise",
      "event_type": "streak_milestone",
      "tone": "inspirational"
    },
    {
      "id": "exercise_streak_004",
      "text": "Nước chảy đá mòn — bạn đang khắc dần những thói quen tốt vào cuộc sống. Đáng tự hào lắm!",
      "source_type": "tuc_ngu",
      "source_name": "Tục ngữ Việt Nam",
      "author": null,
      "verified": true,
      "confidence": "high",
      "category_id": "exercise",
      "event_type": "streak_milestone",
      "tone": "celebratory"
    },
    {
      "id": "exercise_enc_001",
      "text": "Muốn khỏe phải chịu khó, muốn giỏi phải chịu học. Bạn đang trên con đường đúng đắn rồi!",
      "source_type": "sang_tac",
      "source_name": "Sáng tác - Triết lý Việt",
      "author": null,
      "verified": true,
      "confidence": "medium",
      "category_id": "exercise",
      "event_type": "encouragement",
      "tone": "inspirational"
    },
    {
      "id": "exercise_enc_002",
      "text": "Không ai sinh ra đã khỏe — sức khỏe là thành quả của những lựa chọn đúng mỗi ngày. Hãy lựa chọn tốt hôm nay!",
      "source_type": "sang_tac",
      "source_name": "Sáng tác - Triết lý Việt",
      "author": null,
      "verified": true,
      "confidence": "medium",
      "category_id": "exercise",
      "event_type": "encouragement",
      "tone": "strong"
    },
    {
      "id": "exercise_enc_003",
      "text": "Đầu xuôi đuôi lọt — chỉ cần bắt đầu, phần còn lại sẽ tự nhiên theo!",
      "source_type": "tuc_ngu",
      "source_name": "Tục ngữ Việt Nam",
      "author": null,
      "verified": true,
      "confidence": "high",
      "category_id": "exercise",
      "event_type": "encouragement",
      "tone": "gentle"
    },
    {
      "id": "nutrition_task_completed_001",
      "text": "Ăn để sống khỏe, không chỉ sống để ăn — hôm nay bạn đã chọn đúng!",
      "source_type": "sang_tac",
      "source_name": "Sáng tác - Triết lý Việt",
      "author": null,
      "verified": true,
      "confidence": "medium",
      "category_id": "nutrition",
      "event_type": "task_completed",
      "tone": "celebratory"
    },
    {
      "id": "nutrition_task_completed_002",
      "text": "Ăn uống điều độ là thầy thuốc tốt nhất — và hôm nay bạn đang tự chữa bệnh cho mình!",
      "source_type": "sang_tac",
      "source_name": "Sáng tác - Triết lý Việt",
      "author": null,
      "verified": true,
      "confidence": "medium",
      "category_id": "nutrition",
      "event_type": "task_completed",
      "tone": "inspirational"
    },
    {
      "id": "nutrition_task_completed_003",
      "text": "Miếng ăn lành mạnh hôm nay là viên gạch xây nền sức khỏe ngày mai. Bạn vừa đặt thêm một viên!",
      "source_type": "sang_tac",
      "source_name": "Sáng tác - Triết lý Việt",
      "author": null,
      "verified": true,
      "confidence": "medium",
      "category_id": "nutrition",
      "event_type": "task_completed",
      "tone": "celebratory"
    },
    {
      "id": "nutrition_task_completed_004",
      "text": "Cây tốt quả ngon — bạn đang chăm bón cơ thể đúng cách, quả ngọt sức khỏe sẽ đến!",
      "source_type": "tuc_ngu",
      "source_name": "Tục ngữ Việt Nam",
      "author": null,
      "verified": true,
      "confidence": "high",
      "category_id": "nutrition",
      "event_type": "task_completed",
      "tone": "inspirational"
    },
    {
      "id": "nutrition_task_completed_005",
      "text": "Phòng bệnh hơn chữa bệnh — mỗi bữa ăn lành mạnh là một lần phòng bệnh thành công!",
      "source_type": "tuc_ngu",
      "source_name": "Tục ngữ Việt Nam",
      "author": null,
      "verified": true,
      "confidence": "high",
      "category_id": "nutrition",
      "event_type": "task_completed",
      "tone": "strong"
    },
    {
      "id": "nutrition_reminder_001",
      "text": "Uống đủ nước là bước chăm sóc sức khỏe đơn giản nhất — cơ thể bạn đang chờ đó!",
      "source_type": "sang_tac",
      "source_name": "Sáng tác - Triết lý Việt",
      "author": null,
      "verified": true,
      "confidence": "medium",
      "category_id": "nutrition",
      "event_type": "reminder",
      "tone": "gentle"
    },
    {
      "id": "nutrition_reminder_002",
      "text": "Bụng đói thì đầu không sáng — hãy nạp năng lượng đúng cách để chinh phục ngày hôm nay!",
      "source_type": "sang_tac",
      "source_name": "Sáng tác - Triết lý Việt",
      "author": null,
      "verified": true,
      "confidence": "medium",
      "category_id": "nutrition",
      "event_type": "reminder",
      "tone": "gentle"
    },
    {
      "id": "nutrition_reminder_003",
      "text": "Ăn đúng bữa, uống đủ nước — hai việc nhỏ tạo ra sức khỏe lớn. Bạn đã làm hôm nay chưa?",
      "source_type": "sang_tac",
      "source_name": "Sáng tác - Triết lý Việt",
      "author": null,
      "verified": true,
      "confidence": "medium",
      "category_id": "nutrition",
      "event_type": "reminder",
      "tone": "gentle"
    },
    {
      "id": "nutrition_reminder_004",
      "text": "Thực phẩm lành mạnh là thuốc, thuốc tốt nhất lại là thực phẩm lành mạnh. Hãy chọn đúng cho hôm nay!",
      "source_type": "sang_tac",
      "source_name": "Sáng tác - Triết lý Việt",
      "author": null,
      "verified": true,
      "confidence": "medium",
      "category_id": "nutrition",
      "event_type": "reminder",
      "tone": "strong"
    },
    {
      "id": "nutrition_streak_001",
      "text": "Mưa dầm thấm lâu — từng bữa ăn lành mạnh của bạn đang ngấm dần vào sức khỏe. Tuyệt vời!",
      "source_type": "tuc_ngu",
      "source_name": "Tục ngữ Việt Nam",
      "author": null,
      "verified": true,
      "confidence": "high",
      "category_id": "nutrition",
      "event_type": "streak_milestone",
      "tone": "celebratory"
    },
    {
      "id": "nutrition_streak_002",
      "text": "Góp gió thành bão — từng bữa ăn tốt của bạn đang tích lũy thành sức khỏe phi thường!",
      "source_type": "tuc_ngu",
      "source_name": "Tục ngữ Việt Nam",
      "author": null,
      "verified": true,
      "confidence": "high",
      "category_id": "nutrition",
      "event_type": "streak_milestone",
      "tone": "strong"
    },
    {
      "id": "nutrition_enc_001",
      "text": "Biết mình biết ta, trăm trận trăm thắng — biết ăn đúng, sức khỏe luôn chiến thắng!",
      "source_type": "tuc_ngu",
      "source_name": "Tục ngữ Việt Nam",
      "author": null,
      "verified": true,
      "confidence": "high",
      "category_id": "nutrition",
      "event_type": "encouragement",
      "tone": "inspirational"
    },
    {
      "id": "nutrition_enc_002",
      "text": "Người khôn ăn ít ngon nhiều — chất lượng dinh dưỡng quan trọng hơn số lượng. Bạn đang làm đúng!",
      "source_type": "sang_tac",
      "source_name": "Sáng tác - Triết lý Việt",
      "author": null,
      "verified": true,
      "confidence": "medium",
      "category_id": "nutrition",
      "event_type": "encouragement",
      "tone": "gentle"
    },
    {
      "id": "nutrition_enc_003",
      "text": "Ăn để mà sống, chứ đừng sống để mà ăn — triết lý giản đơn giúp bạn chọn thức ăn đúng!",
      "source_type": "tuc_ngu",
      "source_name": "Tục ngữ Việt Nam",
      "author": null,
      "verified": true,
      "confidence": "high",
      "category_id": "nutrition",
      "event_type": "encouragement",
      "tone": "inspirational"
    },
    {
      "id": "sleep_task_completed_001",
      "text": "Ngủ đủ giấc là khi cơ thể tự chữa lành — hôm nay bạn đã cho cơ thể cơ hội đó!",
      "source_type": "sang_tac",
      "source_name": "Sáng tác - Triết lý Việt",
      "author": null,
      "verified": true,
      "confidence": "medium",
      "category_id": "sleep_rest",
      "event_type": "task_completed",
      "tone": "celebratory"
    },
    {
      "id": "sleep_task_completed_002",
      "text": "Nghỉ ngơi đúng lúc không phải lười biếng — đó là sự khôn ngoan của người biết yêu bản thân!",
      "source_type": "sang_tac",
      "source_name": "Sáng tác - Triết lý Việt",
      "author": null,
      "verified": true,
      "confidence": "medium",
      "category_id": "sleep_rest",
      "event_type": "task_completed",
      "tone": "inspirational"
    },
    {
      "id": "sleep_task_completed_003",
      "text": "Cung cấp cho cơ thể giấc ngủ ngon là khoản đầu tư sinh lời nhất cho ngày mai. Bạn vừa đầu tư rồi!",
      "source_type": "sang_tac",
      "source_name": "Sáng tác - Triết lý Việt",
      "author": null,
      "verified": true,
      "confidence": "medium",
      "category_id": "sleep_rest",
      "event_type": "task_completed",
      "tone": "celebratory"
    },
    {
      "id": "sleep_reminder_001",
      "text": "Đêm nằm ngủ yên, ngày làm việc hăng — giấc ngủ đủ là nguồn sức mạnh vô tận!",
      "source_type": "ca_dao",
      "source_name": "Ca dao Việt Nam",
      "author": null,
      "verified": true,
      "confidence": "high",
      "category_id": "sleep_rest",
      "event_type": "reminder",
      "tone": "gentle"
    },
    {
      "id": "sleep_reminder_002",
      "text": "Cơ thể không phải máy móc — nó cần được nghỉ ngơi để tiếp tục mạnh mẽ cho bạn. Đã đến giờ nghỉ chưa?",
      "source_type": "sang_tac",
      "source_name": "Sáng tác - Triết lý Việt",
      "author": null,
      "verified": true,
      "confidence": "medium",
      "category_id": "sleep_rest",
      "event_type": "reminder",
      "tone": "gentle"
    },
    {
      "id": "sleep_reminder_003",
      "text": "Trăm thuốc không bằng giấc ngủ ngon — đừng để màn hình điện thoại cướp mất thầy thuốc tốt nhất của bạn!",
      "source_type": "sang_tac",
      "source_name": "Sáng tác - Triết lý Việt",
      "author": null,
      "verified": true,
      "confidence": "medium",
      "category_id": "sleep_rest",
      "event_type": "reminder",
      "tone": "strong"
    },
    {
      "id": "sleep_reminder_004",
      "text": "Ngủ đúng giờ như trăng mọc đúng lúc — tự nhiên và cần thiết cho sức khỏe của bạn!",
      "source_type": "sang_tac",
      "source_name": "Sáng tác - Triết lý Việt",
      "author": null,
      "verified": true,
      "confidence": "medium",
      "category_id": "sleep_rest",
      "event_type": "reminder",
      "tone": "gentle"
    },
    {
      "id": "sleep_streak_001",
      "text": "Nhất thời không bằng vạn thời — giữ đúng giờ ngủ đều đặn mới là thành tích đáng nể!",
      "source_type": "tuc_ngu",
      "source_name": "Tục ngữ Việt Nam",
      "author": null,
      "verified": true,
      "confidence": "high",
      "category_id": "sleep_rest",
      "event_type": "streak_milestone",
      "tone": "celebratory"
    },
    {
      "id": "sleep_enc_001",
      "text": "Thân tâm an thì vạn sự thành — giấc ngủ ngon là nền tảng của mọi thành công!",
      "source_type": "sang_tac",
      "source_name": "Sáng tác - Triết lý Việt",
      "author": null,
      "verified": true,
      "confidence": "medium",
      "category_id": "sleep_rest",
      "event_type": "encouragement",
      "tone": "inspirational"
    },
    {
      "id": "sleep_enc_002",
      "text": "Sáng ra minh mẫn, tối vào nghỉ ngơi — vòng tuần hoàn sức khỏe đơn giản nhất mà nhiều người bỏ quên!",
      "source_type": "sang_tac",
      "source_name": "Sáng tác - Triết lý Việt",
      "author": null,
      "verified": true,
      "confidence": "medium",
      "category_id": "sleep_rest",
      "event_type": "encouragement",
      "tone": "gentle"
    },
    {
      "id": "mental_task_completed_001",
      "text": "Tâm lành thể khỏe — khi tinh thần vững chắc, cơ thể cũng theo đó mà khỏe mạnh. Bạn đang nuôi dưỡng cả hai!",
      "source_type": "sang_tac",
      "source_name": "Sáng tác - Triết lý Việt",
      "author": null,
      "verified": true,
      "confidence": "medium",
      "category_id": "mental_health",
      "event_type": "task_completed",
      "tone": "inspirational"
    },
    {
      "id": "mental_task_completed_002",
      "text": "Vượt qua chính mình là chiến thắng vĩ đại nhất — và hôm nay bạn vừa chiến thắng!",
      "source_type": "sang_tac",
      "source_name": "Sáng tác - Triết lý Việt",
      "author": null,
      "verified": true,
      "confidence": "medium",
      "category_id": "mental_health",
      "event_type": "task_completed",
      "tone": "celebratory"
    },
    {
      "id": "mental_task_completed_003",
      "text": "Lòng người bình thản như mặt hồ phẳng lặng — chăm sóc tinh thần là chăm sóc điều quý giá nhất!",
      "source_type": "sang_tac",
      "source_name": "Sáng tác - Triết lý Việt",
      "author": null,
      "verified": true,
      "confidence": "medium",
      "category_id": "mental_health",
      "event_type": "task_completed",
      "tone": "celebratory"
    },
    {
      "id": "mental_task_completed_004",
      "text": "Thắng người là dũng, thắng mình là mạnh — bạn vừa thể hiện sức mạnh thực sự hôm nay!",
      "source_type": "tuc_ngu",
      "source_name": "Tục ngữ Việt Nam",
      "author": null,
      "verified": true,
      "confidence": "high",
      "category_id": "mental_health",
      "event_type": "task_completed",
      "tone": "strong"
    },
    {
      "id": "mental_reminder_001",
      "text": "Kỷ luật là yêu thương bản thân — hãy yêu thương mình bằng cách hoàn thành nhiệm vụ hôm nay!",
      "source_type": "sang_tac",
      "source_name": "Sáng tác - Triết lý Việt",
      "author": null,
      "verified": true,
      "confidence": "medium",
      "category_id": "mental_health",
      "event_type": "reminder",
      "tone": "gentle"
    },
    {
      "id": "mental_reminder_002",
      "text": "Tâm bình thì thế giới bình — bắt đầu từ việc nhỏ hôm nay để giữ tâm thế vững vàng!",
      "source_type": "sang_tac",
      "source_name": "Sáng tác - Triết lý Việt",
      "author": null,
      "verified": true,
      "confidence": "medium",
      "category_id": "mental_health",
      "event_type": "reminder",
      "tone": "gentle"
    },
    {
      "id": "mental_reminder_003",
      "text": "Không có gió ngược thì diều không bay lên cao — khó khăn hôm nay là sức mạnh của ngày mai!",
      "source_type": "tuc_ngu",
      "source_name": "Tục ngữ Việt Nam",
      "author": null,
      "verified": true,
      "confidence": "high",
      "category_id": "mental_health",
      "event_type": "reminder",
      "tone": "strong"
    },
    {
      "id": "mental_reminder_004",
      "text": "Một ngày không chăm sóc tinh thần là một ngày để âu lo lấn lướt — hãy dành chút thời gian cho bản thân!",
      "source_type": "sang_tac",
      "source_name": "Sáng tác - Triết lý Việt",
      "author": null,
      "verified": true,
      "confidence": "medium",
      "category_id": "mental_health",
      "event_type": "reminder",
      "tone": "gentle"
    },
    {
      "id": "mental_streak_001",
      "text": "Mưa lâu đất lở, công phu lâu thành — tinh thần bạn đang vững chắc lên từng ngày!",
      "source_type": "tuc_ngu",
      "source_name": "Tục ngữ Việt Nam",
      "author": null,
      "verified": true,
      "confidence": "high",
      "category_id": "mental_health",
      "event_type": "streak_milestone",
      "tone": "celebratory"
    },
    {
      "id": "mental_streak_002",
      "text": "Chí cao tài rộng — khi tinh thần được rèn luyện mỗi ngày, bạn trở nên vô địch với chính mình!",
      "source_type": "sang_tac",
      "source_name": "Sáng tác - Triết lý Việt",
      "author": null,
      "verified": true,
      "confidence": "medium",
      "category_id": "mental_health",
      "event_type": "streak_milestone",
      "tone": "strong"
    },
    {
      "id": "mental_enc_001",
      "text": "Người có chí thì nên — ý chí mạnh mẽ của bạn đang viết nên câu chuyện sức khỏe của riêng mình!",
      "source_type": "tuc_ngu",
      "source_name": "Tục ngữ Việt Nam",
      "author": null,
      "verified": true,
      "confidence": "high",
      "category_id": "mental_health",
      "event_type": "encouragement",
      "tone": "inspirational"
    },
    {
      "id": "mental_enc_002",
      "text": "Trời không phụ kẻ có lòng — nỗ lực chăm sóc bản thân của bạn nhất định sẽ được đền đáp!",
      "source_type": "tuc_ngu",
      "source_name": "Tục ngữ Việt Nam",
      "author": null,
      "verified": true,
      "confidence": "high",
      "category_id": "mental_health",
      "event_type": "encouragement",
      "tone": "inspirational"
    },
    {
      "id": "mental_enc_003",
      "text": "Bước đi trên hành trình nghìn dặm, mỗi ngày chỉ cần tiến thêm một bước nhỏ — bạn đang đi rất đúng hướng!",
      "source_type": "sang_tac",
      "source_name": "Sáng tác - Triết lý Việt",
      "author": null,
      "verified": true,
      "confidence": "medium",
      "category_id": "mental_health",
      "event_type": "encouragement",
      "tone": "gentle"
    },
    {
      "id": "general_task_completed_001",
      "text": "Sức khỏe là vàng — hôm nay bạn vừa góp thêm một chút vàng vào kho báu của mình!",
      "source_type": "tuc_ngu",
      "source_name": "Tục ngữ Việt Nam",
      "author": null,
      "verified": true,
      "confidence": "high",
      "category_id": "general_health",
      "event_type": "task_completed",
      "tone": "celebratory"
    },
    {
      "id": "general_task_completed_002",
      "text": "Có sức khỏe là có tất cả — và bạn đang xây dựng điều đó từng ngày. Tuyệt vời!",
      "source_type": "tuc_ngu",
      "source_name": "Tục ngữ Việt Nam",
      "author": null,
      "verified": true,
      "confidence": "high",
      "category_id": "general_health",
      "event_type": "task_completed",
      "tone": "celebratory"
    },
    {
      "id": "general_task_completed_003",
      "text": "Thân thể khỏe mạnh, tâm hồn phấn khởi — bạn vừa đạt được cả hai hôm nay!",
      "source_type": "sang_tac",
      "source_name": "Sáng tác - Triết lý Việt",
      "author": null,
      "verified": true,
      "confidence": "medium",
      "category_id": "general_health",
      "event_type": "task_completed",
      "tone": "celebratory"
    },
    {
      "id": "general_task_completed_004",
      "text": "Gieo nhân nào gặt quả nấy — hôm nay bạn gieo hạt giống sức khỏe, tương lai sẽ gặt hái sung mãn!",
      "source_type": "tuc_ngu",
      "source_name": "Tục ngữ Việt Nam",
      "author": null,
      "verified": true,
      "confidence": "high",
      "category_id": "general_health",
      "event_type": "task_completed",
      "tone": "inspirational"
    },
    {
      "id": "general_task_completed_005",
      "text": "Bảo vệ sức khỏe hôm nay là tặng quà cho bản thân ngày mai — và bạn vừa tặng một món quà tuyệt vời!",
      "source_type": "sang_tac",
      "source_name": "Sáng tác - Triết lý Việt",
      "author": null,
      "verified": true,
      "confidence": "medium",
      "category_id": "general_health",
      "event_type": "task_completed",
      "tone": "celebratory"
    },
    {
      "id": "general_reminder_001",
      "text": "Phòng bệnh hơn chữa bệnh — một hành động nhỏ hôm nay giúp bạn tránh được trăm lo ngày sau!",
      "source_type": "tuc_ngu",
      "source_name": "Tục ngữ Việt Nam",
      "author": null,
      "verified": true,
      "confidence": "high",
      "category_id": "general_health",
      "event_type": "reminder",
      "tone": "gentle"
    },
    {
      "id": "general_reminder_002",
      "text": "Sức khỏe không chờ đợi — mỗi ngày bỏ qua là một ngày không thể lấy lại. Hãy bắt đầu ngay hôm nay!",
      "source_type": "sang_tac",
      "source_name": "Sáng tác - Triết lý Việt",
      "author": null,
      "verified": true,
      "confidence": "medium",
      "category_id": "general_health",
      "event_type": "reminder",
      "tone": "strong"
    },
    {
      "id": "general_reminder_003",
      "text": "Ngọn nến không tự sáng — sức khỏe cần được chủ động chăm chút mỗi ngày bởi chính bạn!",
      "source_type": "sang_tac",
      "source_name": "Sáng tác - Triết lý Việt",
      "author": null,
      "verified": true,
      "confidence": "medium",
      "category_id": "general_health",
      "event_type": "reminder",
      "tone": "gentle"
    },
    {
      "id": "general_reminder_004",
      "text": "Chữa bệnh tốn tiền, giữ sức khỏe tốn công — thà tốn công hôm nay còn hơn tốn tiền ngày sau!",
      "source_type": "sang_tac",
      "source_name": "Sáng tác - Triết lý Việt",
      "author": null,
      "verified": true,
      "confidence": "medium",
      "category_id": "general_health",
      "event_type": "reminder",
      "tone": "strong"
    },
    {
      "id": "general_streak_001",
      "text": "Tích tiểu thành đại — từng ngày nhỏ bạn chăm sóc sức khỏe đang tích tụ thành điều vĩ đại!",
      "source_type": "tuc_ngu",
      "source_name": "Tục ngữ Việt Nam",
      "author": null,
      "verified": true,
      "confidence": "high",
      "category_id": "general_health",
      "event_type": "streak_milestone",
      "tone": "celebratory"
    },
    {
      "id": "general_streak_002",
      "text": "Nước chảy đá mòn, ý chí vững thì mọi thử thách đều qua — bạn đang chứng minh điều đó!",
      "source_type": "tuc_ngu",
      "source_name": "Tục ngữ Việt Nam",
      "author": null,
      "verified": true,
      "confidence": "high",
      "category_id": "general_health",
      "event_type": "streak_milestone",
      "tone": "strong"
    },
    {
      "id": "general_streak_003",
      "text": "Rèn sắt khi còn nóng — bạn đang rèn thói quen sức khỏe trong khi động lực đang rực cháy. Đừng dừng lại!",
      "source_type": "tuc_ngu",
      "source_name": "Tục ngữ Việt Nam",
      "author": null,
      "verified": true,
      "confidence": "high",
      "category_id": "general_health",
      "event_type": "streak_milestone",
      "tone": "strong"
    },
    {
      "id": "general_enc_001",
      "text": "Trăm hay không bằng tay quen — thói quen lành mạnh tốt hơn ngàn lời hứa với bản thân!",
      "source_type": "tuc_ngu",
      "source_name": "Tục ngữ Việt Nam",
      "author": null,
      "verified": true,
      "confidence": "high",
      "category_id": "general_health",
      "event_type": "encouragement",
      "tone": "inspirational"
    },
    {
      "id": "general_enc_002",
      "text": "Khởi đầu tốt thành công một nửa — mỗi ngày bạn chọn sức khỏe là một ngày bạn đã thắng một nửa rồi!",
      "source_type": "tuc_ngu",
      "source_name": "Tục ngữ Việt Nam",
      "author": null,
      "verified": true,
      "confidence": "high",
      "category_id": "general_health",
      "event_type": "encouragement",
      "tone": "inspirational"
    },
    {
      "id": "general_enc_003",
      "text": "Sức khỏe không phải đích đến — đó là hành trình mỗi ngày. Và bạn đang đi hành trình đó một cách dũng cảm!",
      "source_type": "sang_tac",
      "source_name": "Sáng tác - Triết lý Việt",
      "author": null,
      "verified": true,
      "confidence": "medium",
      "category_id": "general_health",
      "event_type": "encouragement",
      "tone": "inspirational"
    }
  ]
}